				},
				{
					"typeStr": "2",
					"name": "random",
					"display": null
				},
				{
					"typeStr": "8",
					"name": "items",
					"display": null
				}
			],
			"lines": [
				{
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Thank you for completing our demo. The game is available for purchase on Steam now."
						},
						{
							"text": "In the full game, you will be able to continue where you left off in the demo."
						}
					],
					"id": "demo_text"
				},
				{
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Thank you for playing the Early Access version of Cursemark. You have beaten all the available bosses, but a lot more content is in the works. Feel free to keep experimenting with builds, solving secrets, and exploring."
						}
					],
					"id": "ea_text"
				},
				{
					"id": "intro_text",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "His soul may never ascend,"
						},
						{
							"text": "He who bears the Cursemark."
						},
						{
							"text": "A tether to this lesser plane,"
						},
						{
							"text": "Prison to the deathless."
						}
					]
				},
				{
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Smite the sword with strokes thrice and four, to reveal the prize for all the world."
						}
					],
					"id": "clue_Swordfork"
				},
				{
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Stand still a while in a deathly spot, The way to the Cemetery shall be wrought."
						}
					],
					"id": "clue_ShrineDeath"
				},
				{
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Thrice you run aboute Life's Tree, A path shall rise for you to see."
						}
					],
					"id": "clue_ShrineLife"
				},
				{
					"id": "clue_Watchtower",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Run over the bridge to and fro, Where skulls lie scattered in a row."
						}
					]
				},
				{
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Hew down all the sun-flowers bright, To reveal the prize to thy sight."
						}
					],
					"id": "clue_Sunglade"
				},
				{
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "A flask before the monks' storehouse thou shalt sip, To unlock the door with thy lip."
						}
					],
					"id": "clue_AshfordAbbey"
				},
				{
					"id": "clue_LastlightFields",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "A thunder bolt the twinkling tree must smite, When you gleam the last bit of light."
						}
					]
				},
				{
					"id": "clue_Duskridge",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "In the place where dusk last gleams bright, Trace the creek as the sun does flight."
						}
					]
				},
				{
					"id": "clue_CrystalCreek",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "At the withered tree where waters entwine, Loose thy Ultimate, and the secret is thine."
						}
					]
				},
				{
					"id": "clue_TempleCourtyard",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Touch the headstone sunk in the deep, Step into the waters if the spring you would reap."
						}
					]
				},
				{
					"id": "clue_SpringLife",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Where shallow waters lap the crescent stones, Let east and west in answering strokes be thrown."
						}
					]
				},
				{
					"id": "clue_ForestCamp",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "If seven watch-fires be kindled with haste, The camp's relief shall then be graced."
						}
					]
				},
				{
					"id": "clue_DeathGorge",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "By chill and frost make dark the torches two, Beneath the place the fallen giant knew."
						}
					]
				},
				{
					"id": "clue_LoversRest",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Where brambles cover hearts that rest as one, Stand between their tombs, and the secret will be shown."
						}
					]
				},
				{
					"id": "clue_Shadowverge",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Where stubborn stone hath sealed the secret rite, By blast break through, and bring it unto sight."
						}
					]
				},
				{
					"id": "clue_Voidmouth",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Upon the span above the waiting Void, Yield up thy breath, and wake what shadows hide."
						}
					]
				},
				{
					"id": "clue_SunfishPond",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Those which come easy to those that come hard, Where bright fish swim, these four you must discard."
						}
					]
				},
				{
					"id": "clue_Sedgepool",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Present yourself broken, depleted, powerless, and unadorned. Amidst the dead may you be transformed."
						}
					]
				},
				{
					"id": "clue_RunoffBasin",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "The second, the third, and then the first, The Totems have thus conversed."
						}
					]
				},
				{
					"id": "clue_WitchsHut",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "In the home of the hag, extinguish all joy and preserve all misery, for a sip of the cauldron for thee."
						}
					]
				},
				{
					"id": "clue_TheFingers",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Within your open palm it lies. Dash, and claim the waiting prize."
						}
					]
				},
				{
					"id": "clue_FungalShrine",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "The Fairy Ring accepts no gift but one. Offer up thy Finger, and the rite is done."
						}
					]
				},
				{
					"id": "void_eye_intro",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Thou standest here at the last, with that pale spark thou callest a soul."
						},
						{
							"text": "For death is no outward door to thee, Cursemarked. "
						},
						{
							"text": "I shall restore thee, so ye shall never leave the prison of thine own life."
						}
					]
				},
				{
					"id": "crone_intro",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Come forth, child. You've ventured this far into a strange land, do not be coy now."
						}
					]
				},
				{
					"id": "crone_sacrifice",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Blood is the price, Cursemarked. Oh yes, you will pay it many times over."
						},
						{
							"text": "Now take your life, mingle your blood with this land, and be bound to it."
						},
						{
							"text": "The Eye of the Void shall witness you, and the wheel of Valoria shall spin."
						}
					]
				},
				{
					"id": "priestess_call",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Ah, a new soul is trapped in the spiritual rapids. Please, come talk to me when you can."
						}
					]
				},
				{
					"id": "priestess_intro",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Greetings, Cursemarked... it's been many years since the last sorrowful visitor appeared here."
						},
						{
							"text": "I see the contemptible Void Eye has pierced you, alas. It's poison straight to the heart."
						},
						{
							"text": "As a small comfort, please take this, I offer it humbly."
						}
					]
				},
				{
					"id": "priestess_intro2",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "An Attunement Sigil... its small warmth is a rare thing in this place."
						},
						{
							"text": "Bring me them, and I will shed their warmth upon you, enlightening you to new skills."
						}
					]
				},
				{
					"id": "priestess_chatter",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "The Seven alignments, the Seven seals, Seven sources of power. Draw deeply from them and prosper."
						},
						{
							"text": "Yes, drink from the wellspring of knowledge, and grow."
						},
						{
							"text": "The Dragons, the Giants, the Old Gods, all gone now. But traces of their power remains."
						},
						{
							"text": "The centuries have come and gone, but their wisdom lingers in me."
						},
						{
							"text": "Listen and prosper, fair Knight."
						}
					]
				},
				{
					"id": "dummy_message",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Ever........ Ready........ For........"
						},
						{
							"text": "The.........."
						},
						{
							"text": "Battle..... To....... Come........"
						}
					]
				},
				{
					"id": "fence_intro",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "Boil the seas, burn the trees... Pillage the future to fix the past... Ehehehe... What future do we have, anyway?"
						},
						{
							"text": "A book is firestarter, love is a cruel trick, hope is a fish hook... Ehehehe... You know this to be true."
						},
						{
							"text": "Do not ask where the Runes come from, would you really want the answer anyway?"
						},
						{
							"text": "Don't bother with hope, if you want my advice. Tomorrow is a long ways away..."
						},
						{
							"text": "Ehehehe... you can't really help yourself, can you? Don't feel bad, just take what you need..."
						}
					]
				},
				{
					"id": "mystic_intro",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "A man of light has much to fear moving through dark lands. Better to keep your head down and avert the evil gaze."
						},
						{
							"text": "It is not just your feet on this journey, it is your soul as well. Never let either rest too long..."
						},
						{
							"text": "There is no answer to \"why\", all things are exactly as they are. If you ask \"why\", you may as well ask a stone."
						},
						{
							"text": "Continue your work, Cursemarked. Keep your eyes only a little ahead of you."
						},
						{
							"text": "Your body may move in a wheel of life and death, but your soul advances ever onwards."
						}
					]
				},
				{
					"id": "paladin_intro",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "The deathless road we walk is long, and tiresome, and old. Succor is rare, and I have little to offer."
						},
						{
							"text": "I still see an ember burning in you... good, good..."
						},
						{
							"text": "On and on, eh? This world may reduce us by half, again and again, but never quite brings us to nothing."
						},
						{
							"text": "To be safe in nothingness, that is the evil offer we must refuse daily."
						},
						{
							"text": "To give what little we have, is the only way to get more."
						}
					]
				},
				{
					"id": "stalwart_intro",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Better be dern sure you wanna go this way... The water gets deep quick if you catch my meaning."
						},
						{
							"text": "The key is waiting in Sloughouse. If you can't even get that, you got no business here..."
						}
					]
				},
				{
					"id": "stalwart_proceed",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Well, you got the key. What are you waiting fer? Try yer luck or turn around and rot away..."
						}
					]
				},
				{
					"id": "luminary_talk",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "Runes are sacred and precious things, creations of the Empyrean Eye."
						},
						{
							"text": "It does not do to dwell on our cursed lot in life. "
						},
						{
							"text": "To accept our punishment is divine."
						},
						{
							"text": "The rune holds power most knaves barely understand."
						},
						{
							"text": "The subtle inscriptions, the faint heat, the glow... ahh the rune is truly a marvelous thing."
						}
					]
				},
				{
					"id": "blacksmith_call",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Hey there, Stranger! Come chat with me when you have a moment..."
						}
					]
				},
				{
					"id": "blacksmith_intro",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Hey Stranger, welcome to our little foothold on the edge of the world."
						},
						{
							"text": "I can set you up with Forge Overcharges. These will add an extra level when you upgrade a Rune or Talisman. "
						},
						{
							"text": "Don't keep me waiting, Stranger..."
						}
					]
				},
				{
					"id": "blacksmith_chatter",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "Hey, I'll bang on your sword a bit. No problem."
						},
						{
							"text": "Let's see your steel, what are you working with?"
						},
						{
							"text": "Stay sharp out there. Nobody likes a dull blade."
						},
						{
							"text": "Steel is honest. Can't say the same for most people."
						},
						{
							"text": "Keep me busy and I'll keep you fighting. Deal?"
						}
					]
				},
				{
					"id": "shaman_call",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "I've returned from a long journey. I have much to show you..."
						}
					]
				},
				{
					"id": "shaman_chatter",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "A lone rune hums softly. Two in harmony begin to sing."
						},
						{
							"text": "Do not force the pattern. Open a new hollow, and the old stones will show their kin."
						},
						{
							"text": "Some powers sleep beside each other in silence, waiting for an empty place between them."
						},
						{
							"text": "Each new hollow is a small permission. The runes hear it, and draw closer to their true shape."
						},
						{
							"text": "Be patient with the lattice. When there is room enough, even quiet runes will speak to one another."
						}
					]
				},
				{
					"id": "cartographer_intro",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Ah, a hopeful new face. The Temple of Iron is your destination, whether you know it yet or not."
						},
						{
							"text": "The road is perilous, and I’d rather not have you wandering it blindly, so I shall mark it upon your map."
						}
					]
				},
				{
					"id": "cartographer_map",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "There. Even you should be able to find it now. Do try to arrive in one piece."
						},
						{
							"text": "When you clear an area, your map will let you travel there instantly. It would be unwise to forget this."
						}
					]
				},
				{
					"id": "cartographer_forest",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "And here he comes, my hapless acquaintance. The darkness billowing forth before you leads into the Cursewoods. Not a pleasant sounding place, eh?"
						},
						{
							"text": "You would be wise to stay away, hence I suspect you will not. At the far edge lies the Temple of Shadow. I shall mark it for you, though it is no favor."
						}
					]
				},
				{
					"id": "cartographer_swamp",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Ah, my friend, I see you've stumbled your way to the precipice of a distant and unfriendly place."
						},
						{
							"text": "Beyond here is what's known as the Mire Glades. Truthfully, it is a devilish and tricky place to navigate."
						},
						{
							"text": "The Temple of Decay sits deep within, though I must advise you go no farther..."
						}
					]
				},
				{
					"id": "cartographer_garden",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Yes, I knew that clanking and stomping was you. You've trudged quite far into this world, with your heavy foot."
						},
						{
							"text": "I'm afraid this garden is rather closed. The price of admittance is blood I fear, in the Heart of the Woods."
						}
					]
				},
				{
					"id": "cartographer_archons",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "The water ahead is swift and deep my friend, if you catch my meaning. You should rather consider your path."
						},
						{
							"text": "However, if you're quite intent, the key is in Sloughouse. If you can't even get that, well..."
						}
					]
				},
				{
					"id": "cartographer_chatter",
					"ref": "",
					"random": true,
					"items": [
						{
							"text": "You stand in a lesser plane, whether you grasp it or no. A dim stratum, far beneath the higher turns of existence."
						},
						{
							"text": "The Eye of Ascendence is the only way upward. I should think that much would be obvious."
						},
						{
							"text": "The Eye lies behind seven seals, each one set to bar the unworthy and the witless alike."
						},
						{
							"text": "The seals are guarded fiercely. Lesser beings do so love their violence."
						},
						{
							"text": "Do not mistake this plane for the summit of anything. It is but a lower rung beneath the Eye."
						}
					]
				},
				{
					"id": "osric_first",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "You damn pathetic worms, crawling out of the ground. Endless, endless streams of you."
						},
						{
							"text": "How many times must I crush you underfoot, again and again, before you stop?"
						}
					]
				},
				{
					"id": "lucian_first",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "Ah, another hopeful ascendant... I fear I have limited welcome to offer you."
						},
						{
							"text": "Pah, hope. What an arrogant concept. Humility will serve you much better in this place."
						}
					]
				},
				{
					"id": "vessel_first",
					"ref": "",
					"random": false,
					"items": [
						{
							"text": "The joke is that you think you're free. Truthfully, you are no more than this body I puppeteer."
						},
						{
							"text": "A marionette, animated by forces far beyond your comprehension."
						},
						{
							"text": "You come, you fight, you die. It's all just so much gaudy theatre."
						},
						{
							"text": "Well, the audience is waiting. The show must begin."
						}
					]
				}
			],
			"separators": [
				3,
				25,
				51
			],
			"props": {
				"separatorTitles": [
					"Clues",
					"NPCs",
					"Bosses"
				]
			}
		},
