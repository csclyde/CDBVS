				},
				{
					"name": "Energy",
					"color": 2023238,
					"description": "A resource gained with Weapon attacks and spent on Spells."
				},
				{
					"name": "Armor",
					"color": 3908891,
					"description": "Reduces incoming damage when you are hit."
				},
				{
					"name": "Crit;Crits;critical",
					"color": 3908891,
					"description": "A Crit does double damage."
				},
				{
					"name": "Ward;Wards",
					"color": 16760123,
					"description": "Wards are skills focused on defense with limited uses per level."
				},
				{
					"name": "Ultimate;Ultimates",
					"color": 16760123,
					"description": "Ultimates are skills which charge up slowly from all other damage you deal."
				},
				{
					"name": "Weapon;Weapons",
					"color": 16760123,
					"description": "Weapons are skills that generate energy. Weapons often have a series of attacks and a special attack after dashing."
				},
				{
					"name": "Spell;Spells",
					"color": 16760123,
					"description": "Spells are your primary offensive power, they consume energy in exchange for a variety of damaging effects."
				},
				{
					"name": "Talisman;Talismans",
					"color": 16760123,
					"description": "Talismans are items you place into special slots that modify stats and all skills."
				},
				{
					"name": "Rune;Runes",
					"color": 16760123,
					"description": "Runes are items that you place into a skill's sockets to modify them."
				},
				{
					"name": "Aura;Auras",
					"color": 3908891,
					"description": "Auras are a circle of passive effects around you."
				},
				{
					"name": "Barrier",
					"color": 3908891,
					"description": "A temporary shield that absorbs damage instead of your health."
				},
				{
					"name": "Evasion;evade;evading",
					"color": 3908891,
					"description": "Your chance to avoid an incoming attack."
				},
				{
					"name": "Stun",
					"color": 3908891,
					"description": "Temporarily prevents enemies from acting."
				},
				{
					"name": "Harden;Hardening;harden",
					"color": 3908891,
					"description": "Hardening temporarily provides bonus armor."
				},
				{
					"name": "Dash;dashing",
					"color": 3908891,
					"description": "Your burst movement used to reposition or evade."
				},
				{
					"name": "Lunge;lunging",
					"color": 3908891,
					"description": "A Lunge is a unique attack most weapons can execute right after dashing"
				},
				{
					"name": "Range",
					"color": 3908891,
					"description": "How far an attack or effect can reach."
				},
				{
					"name": "Haste",
					"color": 3908891,
					"description": "A burst of extra skill and movement speed, often after casting."
				},
				{
					"name": "Concealed;conceal",
					"color": 3908891,
					"description": "A status that guarantees evasion until you attack or cast a spell."
				},
				{
					"name": "Reflection;reflect;reflects;reflecting;reflected",
					"color": 3908891,
					"description": "Your chance to send incoming projectiles back at attackers."
				},
				{
					"name": "Burning",
					"color": 3908891,
					"description": "A fire status effect that drains health over time."
				},
				{
					"name": "Frozen;Freezing",
