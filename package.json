{
  "name": "cdbvs",
  "displayName": "CDBVS",
  "description": "A desktop VS Code editor for CastleDB .cdb files.",
  "version": "0.1.19",
  "publisher": "CLYDE",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/csclyde/CDBVS.git"
  },
  "bugs": {
    "url": "https://github.com/csclyde/CDBVS/issues"
  },
  "homepage": "https://github.com/csclyde/CDBVS#readme",
  "preview": true,
  "keywords": [
    "CastleDB",
    "CDB",
    "database",
    "JSON",
    "editor"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "test": "npm run build && node --test test/parser.test.js test/protocol.test.js test/domain.test.js test/host.test.js test/bootstrap.test.js test/model.test.js test/ui-branches.test.js test/webview.test.js test/list-modal.test.js test/extension.test.js",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "activationEvents": [
    "onLanguage:cdb",
    "onCustomEditor:cdb.editor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cdb",
        "aliases": ["CastleDB", "CDB"],
        "extensions": [".cdb"],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "cdb.editor",
        "displayName": "CDBVS Editor",
        "selector": [
          {
            "filenamePattern": "*.cdb"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "cdb.openEditor",
        "title": "CDBVS: Open CastleDB Editor"
      },
      {
        "command": "cdb.validate",
        "title": "CDBVS: Validate Current File"
      },
      {
        "command": "cdb.format",
        "title": "CDBVS: Format Current File"
      }
    ],
    "configuration": {
      "title": "CDBVS",
      "properties": {
        "cdbvs.showHiddenSheets": {
          "type": "boolean",
          "default": false,
          "description": "Show CastleDB internal/hidden sheets in the editor."
        }
      }
    }
  }
}
